---
layout: none
---
[
  {% for demo in site.demos %}
    {
      "title"    : {{ demo.title | strip_html | strip_newlines | jsonify }},
      "category" : {{ demo.category | strip_html | strip_newlines | jsonify }},
      "url"      : "{{ site.baseurl }}{{ demo.url }}"
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
